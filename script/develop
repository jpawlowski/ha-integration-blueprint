#!/bin/bash

# script/develop: Start Home Assistant in development mode
#
# Starts Home Assistant with asyncio debug mode enabled, in the active Home Assistant
# environment (script/ha-env) and its config directory: config/ for minimum, another one
# that shares configuration.yaml with it otherwise. --env switches to another environment
# first, installing it when needed; it refuses while Home Assistant runs on another environment,
# unless --force says to take that instance over. This does not change any log level — those come from
# the logger: block in config/configuration.yaml. Automatically cleans up accidental package
# installations and sets PYTHONPATH to load the integration from custom_components/.
#
# Usage:
#   ./script/develop [--env minimum|latest|beta [--force]]
#
# Examples:
#   ./script/develop
#   ./script/develop --env beta

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"
# shellcheck source=script/.lib/download.sh
source "$SCRIPT_DIR/.lib/download.sh"
# shellcheck source=script/.lib/ha_version.sh
source "$SCRIPT_DIR/.lib/ha_version.sh"
# shellcheck source=script/.lib/ha_envs.sh
source "$SCRIPT_DIR/.lib/ha_envs.sh"

ENV_SLOT=""
FORCE=false
while [[ $# -gt 0 ]]; do
    case "$1" in
    --env)
        ENV_SLOT="${2:?--env needs minimum, latest or beta}"
        shift 2
        ;;
    --force)
        FORCE=true
        shift
        ;;
    *)
        log_error "Unknown option: $1 (usage: script/develop [--env minimum|latest|beta [--force]])"
        exit 2
        ;;
    esac
done

# Switching moves every terminal and script/test along; never do that under someone else's running instance by accident.
ACTIVE_SLOT="$(ha_envs_current_slot)"
if [[ -n $ENV_SLOT && $ENV_SLOT != "${ACTIVE_SLOT:-minimum}" && $FORCE == false ]] &&
    pgrep -f "hass --config ${PWD}/(config|\.local/ha-config/)" >/dev/null; then
    log_error "Home Assistant is running on ${ACTIVE_SLOT:-minimum}: --env $ENV_SLOT would stop it and switch every terminal"
    log_step "Stop it first, or take it over on purpose: script/develop --env $ENV_SLOT --force"
    exit 1
fi

# Kill any existing Home Assistant and debugpy processes
log_header "Cleaning up existing processes"
if pkill -f "hass --config ${PWD}/(config|\.local/ha-config/)"; then
    log_info "Stopped existing Home Assistant process"
fi
if pkill -f "debugpy.*5678"; then
    log_info "Stopped existing debugpy process (port 5678)"
fi
sleep 1 # Give processes time to terminate

if [[ -n $ENV_SLOT ]]; then
    if [[ -z $(ha_envs_version_of "$ENV_SLOT") ]]; then
        "$SCRIPT_DIR/ha-env" add "$ENV_SLOT"
    fi
    "$SCRIPT_DIR/ha-env" use "$ENV_SLOT"
fi

activate_venv
ha_envs_notice
export HA_CONFIG_DIR
HA_CONFIG_DIR="$(ha_config_dir)"
CONFIG_PATH="${PWD}/${HA_CONFIG_DIR}"
HA_RUNNING_VERSION="$(python3 -c 'from homeassistant.const import __version__; print(__version__)')"

# Clean up critical issues (accidental package installations)
# Uses minimal mode to avoid deleting useful caches
"$SCRIPT_DIR/clean" --minimal

# Create config dir if not present
if [[ ! -d ${PWD}/config ]]; then
    mkdir -p "${PWD}/config"
    hass --config "${PWD}/config" --script ensure_config
fi
if [[ $HA_CONFIG_DIR != config ]]; then
    ha_envs_prepare_config "$HA_CONFIG_DIR" "$HA_RUNNING_VERSION"
fi
ha_envs_guard_config "$HA_CONFIG_DIR" "$HA_RUNNING_VERSION"

"$SCRIPT_DIR/setup/seed-http-config"
"$SCRIPT_DIR/setup/sync-hacs"

run_hook "develop" "pre"

# Mint the token script/ha authenticates with. Deliberately after the hook, so a
# downstream repository can opt out with `export HA_DEV_TOKEN=0` in
# script/hooks/develop.pre.sh. Never fatal — Home Assistant must still start.
"$SCRIPT_DIR/setup/seed-auth" || log_warning "Continuing without a development token"

# The repository root on the path adds <root>/custom_components to the
# custom_components namespace package, beside config/custom_components.
export PYTHONPATH="${PWD}${PYTHONPATH:+:${PYTHONPATH}}"

log_header "Starting Home Assistant in development mode"
log_info "Home Assistant: ${HA_RUNNING_VERSION} ($(ha_envs_current_slot || true))"
log_info "Config directory: ${CONFIG_PATH}"
mkdir -p .local
printf '{"slot": "%s", "version": "%s", "config_dir": "%s", "started_by": "%s", "started_at": "%s"}\n' \
    "$(ha_envs_current_slot || true)" "$HA_RUNNING_VERSION" "$HA_CONFIG_DIR" "$(ha_actor)" "$(date -Is)" >.local/ha-develop.json
log_info "asyncio debug mode: enabled"
log_separator
echo ""

# Start Home Assistant
hass --config "${CONFIG_PATH}" --debug
